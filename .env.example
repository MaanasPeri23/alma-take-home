# Local development only. Every value here is a throwaway default; nothing is secret.

POSTGRES_USER=leads
POSTGRES_PASSWORD=leads
POSTGRES_DB=leads
DATABASE_URL=postgresql+psycopg://leads:leads@db:5432/leads

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes

SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=leads@example.com
ATTORNEY_EMAIL=attorney@example.com

JWT_SECRET=dev-only-not-a-secret-change-me-in-production
COOKIE_SECURE=false

# The attorney account `make seed` creates. Same address as ATTORNEY_EMAIL, so the person who
# gets new-lead emails is the person who logs in.
SEED_ATTORNEY_EMAIL=attorney@example.com
SEED_ATTORNEY_PASSWORD=change-me-locally

# Base URL of the web app, used for links in emails.
PUBLIC_BASE_URL=http://localhost:3000
